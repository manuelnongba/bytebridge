# Copy to .env and run npm run server:local. Never commit real secrets.
HOST=localhost
PORT=1234
YPERSISTENCE=.bytebridge-data
ROOM_CREATION_KEY=
# Remote listeners require HTTPS. See docs/PHASE_1.md before exposing a server.
# TLS_CERT=/absolute/path/to/cert.pem
# TLS_KEY=/absolute/path/to/key.pem
# TRUST_TLS_PROXY=1
