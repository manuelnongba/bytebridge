# Copy to .env and run npm run server:local. Never commit real secrets.
HOST=localhost
PORT=1234
YPERSISTENCE=.bytebridge-data
ROOM_CREATION_KEY=
# Remote listeners require HTTPS. See docs/PHASE_1.md before exposing a server.
# TLS_CERT=/absolute/path/to/cert.pem
# TLS_KEY=/absolute/path/to/key.pem
# TRUST_TLS_PROXY=1

# Optional AI catch-up. Keys stay on the server; restart after changing settings.
AI_ENABLED=0
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
# Failed/canceled provider attempts count too. Limits reset on server restart.
AI_ROOM_REQUESTS_PER_HOUR=20
AI_REQUESTS_PER_HOUR=100
