{
  "name": "bytebridge",
  "version": "1.0.0",
  "description": "A shared workspace for collaborative coding and debugging",
  "main": "dist/main/main.js",
  "build": {
    "appId": "app.bytebridge.desktop",
    "productName": "ByteBridge",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "protocols": [
        {
          "name": "ByteBridge Invitation",
          "schemes": [
            "myapp"
          ]
        }
      ],
      "icon": "assets/branding/icon.png"
    },
    "directories": {
      "buildResources": "assets/branding",
      "output": "release"
    },
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ]
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "server:local": "npm run build:server && node --env-file=.env scripts/server.mjs",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "build:types": "tsc -p tsconfig.app.json",
    "build": "npm run build:types && webpack --config webpack.config.js && npm run build:main",
    "build:main": "tsc -p tsconfig.main.json",
    "watch": "webpack --watch --config webpack.config.js",
    "start": "npm run build && electron .",
    "dev": "NODE_ENV=development electron .",
    "test": "npm run build:types && npm run build:main && node --test tests/*.test.mjs",
    "test:profiles": "npm run build && node scripts/check-profiles.mjs",
    "test:desktop": "npm run build && electron scripts/check-desktop.mjs && electron scripts/check-desktop.mjs --cold-invite",
    "server": "npm run build:server && node --env-file=.env scripts/server.mjs",
    "dist": "npm run build:release && electron-builder",
    "cloudflare:dev": "wrangler dev --config cloudflare/wrangler.jsonc",
    "cloudflare:typecheck": "tsc -p cloudflare/tsconfig.json",
    "cloudflare:build": "wrangler deploy --dry-run --config cloudflare/wrangler.jsonc --outdir ../dist/cloudflare",
    "cloudflare:deploy": "wrangler deploy --config cloudflare/wrangler.jsonc",
    "build:release": "npm run build:types && webpack --mode production --config webpack.config.js && npm run build:main",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/node": "^24.5.2",
    "@types/ws": "^8.18.2",
    "copy-webpack-plugin": "^13.0.1",
    "css-loader": "^7.1.2",
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12",
    "prettier": "3.9.9",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.2",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1",
    "wrangler": "^4.151.2"
  },
  "type": "module",
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@y/websocket-server": "^0.1.1",
    "ignore": "^7.0.12",
    "lib0": "^0.2.119",
    "monaco-editor": "^0.53.0",
    "node-pty": "^1.1.0",
    "ws": "^8.22.0",
    "y-monaco": "^0.1.6",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.27"
  }
}
