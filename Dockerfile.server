FROM node:22-bookworm-slim AS compile
WORKDIR /app
ENV ELECTRON_SKIP_BINARY_DOWNLOAD=1
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json tsconfig.app.json tsconfig.server.json ./
COPY src/server ./src/server
COPY src/shared/ai.ts ./src/shared/ai.ts
RUN npm run build:server

FROM node:22-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY scripts/server.mjs ./scripts/server.mjs
COPY --from=compile /app/dist/typescript/server ./dist/typescript/server
COPY --from=compile /app/dist/typescript/shared ./dist/typescript/shared
RUN mkdir /data && chown node:node /data
USER node
ENV HOST=0.0.0.0 PORT=1234 YPERSISTENCE=/data
VOLUME /data
EXPOSE 1234
CMD ["node", "scripts/server.mjs"]
